# 研究输入、抓包、实验及生成产物保留在本机。
/.tmp/
/artifacts/
/build/
/dist/
/coverage/
**/target/
**/node_modules/
**/.sites-runtime/
**/.playwright-cli/
**/test-results/
**/playwright-report/
/apps/*/dist/
/apps/desktop/gen/
/collectors/*/dist/
/collectors/qqnt-windows/host/bin/
/collectors/qqnt-windows/host/obj/
/.cache/

# 本机 AI 工具配置、记录及已安装技能保留在本机。
/.codex/
/.claude/
/.agents/
/.cursor/

# impeccable 插件的本机设计缓存及忽略记录。
/.impeccable/

# 本机凭据保持私密，示例仅使用合成值。
.env
.env.*
!.env.example

# 系统元数据。
Thumbs.db
Desktop.ini
.DS_Store

# 按目录区分产物，保留经审核的最小样本及源码资源在 Git 中可见。
